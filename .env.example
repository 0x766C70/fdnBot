# Copiez ce fichier vers .env et renseignez vos clés.

# Requis : clé API Mistral (https://console.mistral.ai/) pour le modèle de l'agent
MISTRAL_API_KEY=''

# Requis : clé API Tavily (https://tavily.com/) pour la recherche web
TAVILY_API_KEY=''

# Optionnel : modèle Mistral utilisé par l'agent (défaut : mistral-large-latest)
# MISTRAL_MODEL='mistral-large-latest'

# Optionnel : observabilité LangSmith (https://smith.langchain.com/)
# Mettre LANGSMITH_TRACING='true' pour tracer toutes les requêtes
# (appels LLM, outils, garde-fou), filtrables par thread_id et search_armed.
# LANGSMITH_TRACING='true'
# LANGSMITH_API_KEY=''
# LANGSMITH_PROJECT='fdnbot'
# Pour l'instance EU : LANGSMITH_ENDPOINT='https://eu.api.smith.langchain.com'
